OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
ECOS_API_KEY=
BLS_API_KEY=
DART_API_KEY=
KRX_ID=
KRX_PW=
# 공공데이터포털(data.go.kr) "금융위원회_금융투자협회종합통계정보" — 신용공여 잔고/증시자금
# 일별 데이터. www.data.go.kr에서 해당 API 활용신청 후 발급받은 서비스키를 그대로 넣는다
# (이미 URL-인코딩된 형태로 발급됨 — 그대로 붙여넣으면 된다, 코드가 디코딩해서 씀).
KOFIA_API_KEY=
# Gemini(Google AI Studio) — AI 해설/8-K 요약에서 엔진을 "Gemini"로 선택했을 때만 쓰인다.
# BASE_URL/MODEL을 비워두면 코드 기본값(OpenAI 호환 엔드포인트, gemini-flash-latest)을 쓴다.
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=
# 토스증권 Open API(openapi.tossinvest.com) — OAuth2 Client Credentials Grant용 앱 키.
# 발급 시 등록한 IP에서만 토큰이 발급된다(허용 IP 미등록이면 403). 계좌·주문 API는 이 프로젝트가
# 쓰지 않는다(리서치 전용) — 시세/투자자 수급 등 조회성 API만 사용한다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# KOSIS(국가통계포털) 공유서비스 OpenAPI 인증키 — kosis.kr 자체 발급(공공데이터포털 경유 아님),
# 회원가입 후 "활용신청" 탭에서 자동승인. 현재는 검증 전용(카탈로그 미연결).
KOSIS_API_KEY=